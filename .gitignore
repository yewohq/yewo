# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Tool caches and coverage data
.coverage
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv
.env
assets/
example/other_testing_apps/
docs/
test_models/
# macOS
.DS_Store

# Claude Code's own settings, which are this machine's rather than the
# project's.
.claude/

# Eval sweeps: one run of the screen corpus, kept local like any other run
sweeps/

# Legacy local replay caches and temporary files used while replacing a path.
**/.yewo/replay/
**/.yewo/replay-key
**/.yewo/paths/**/*.part
