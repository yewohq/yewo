# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Tool caches and coverage data
.coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv
.env
assets/
docs/*
!docs/testing.md
!docs/development.md
test_models/
.yewo/
# macOS
.DS_Store

# Claude Code's own settings, which are this machine's rather than the
# project's.
.claude/

# Eval sweeps: one run of the screen corpus, kept local like any other run
sweeps/
eval/perception/screens/runs/
eval/runs/

# Evaluation app packages are materialized from the tracked manifest. Keep the
# small metadata in Git and the large deployable binaries outside its history.
eval/apps/android/*.apk
eval/apps/ios/*.app/

# AndroidWorld is pinned by the integration setup, not vendored into Yewo.
eval/integrations/android_world/.venv/
eval/integrations/android_world/vendor/

# Local archived experiments and live-run output.
old/
live_runs/
eval/local_apps/
