{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/yewohq/yewo/master/yewo-schema.json",
  "$defs": {
    "AccessibilityCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "accessibility",
          "default": "accessibility",
          "title": "Kind",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "AccessibilityCapability",
      "type": "object"
    },
    "AppStateCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "app_state",
          "default": "app_state",
          "title": "Kind",
          "type": "string"
        },
        "action": {
          "enum": [
            "force_stop",
            "clear_data",
            "relaunch",
            "background_resume"
          ],
          "title": "Action",
          "type": "string"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "maximum": 60,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds to remain backgrounded. Only background_resume uses it.",
          "title": "Duration Seconds"
        }
      },
      "required": [
        "action"
      ],
      "title": "AppStateCapability",
      "type": "object"
    },
    "BatteryCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "battery",
          "default": "battery",
          "title": "Kind",
          "type": "string"
        },
        "level": {
          "maximum": 100,
          "minimum": 0,
          "title": "Level",
          "type": "integer"
        },
        "charging": {
          "default": true,
          "title": "Charging",
          "type": "boolean"
        }
      },
      "required": [
        "level"
      ],
      "title": "BatteryCapability",
      "type": "object"
    },
    "BiometricCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "biometric",
          "default": "biometric",
          "title": "Kind",
          "type": "string"
        },
        "action": {
          "enum": [
            "match",
            "unmatch",
            "enroll"
          ],
          "title": "Action",
          "type": "string"
        },
        "type": {
          "default": "faceId",
          "enum": [
            "faceId",
            "touchId"
          ],
          "title": "Type",
          "type": "string"
        },
        "finger_id": {
          "default": 1,
          "minimum": 1,
          "title": "Finger Id",
          "type": "integer"
        }
      },
      "required": [
        "action"
      ],
      "title": "BiometricCapability",
      "type": "object"
    },
    "Category": {
      "description": "What a scenario looks for.",
      "enum": [
        "functional",
        "input",
        "security",
        "accessibility",
        "performance",
        "network",
        "lifecycle",
        "permission"
      ],
      "title": "Category",
      "type": "string"
    },
    "ClipboardCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "clipboard",
          "default": "clipboard",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ClipboardCapability",
      "type": "object"
    },
    "CoverageSpec": {
      "additionalProperties": false,
      "description": "One category, and which shapes of test to write for it.\n\nEight categories and nine types give up to seventy-two pairs. One model\ncall per pair is only affordable where a file says which pairs matter. A\npair nothing declares is never generated, and the report names it as\nuncovered.",
      "properties": {
        "category": {
          "$ref": "#/$defs/Category",
          "description": "What these scenarios look for."
        },
        "types": {
          "description": "Which shapes of test to write for this category.",
          "items": {
            "$ref": "#/$defs/ScenarioType"
          },
          "minItems": 1,
          "title": "Types",
          "type": "array"
        },
        "priority": {
          "$ref": "#/$defs/Priority",
          "default": "P1",
          "description": "Which cells a run has to finish first, if it cannot finish all."
        }
      },
      "required": [
        "category",
        "types"
      ],
      "title": "CoverageSpec",
      "type": "object"
    },
    "DeclaredValue": {
      "additionalProperties": false,
      "description": "A declared value, whether it is sensitive, and what the app owes it.\n\nA value marked secret is replaced by its name in everything Yewo writes\ndown. Nothing else is masked, so a credential written straight into the\njourney text is not hidden.",
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "secret": {
          "default": false,
          "title": "Secret",
          "type": "boolean"
        },
        "redaction": {
          "default": "hide",
          "description": "How much of this value an external model may receive.",
          "enum": [
            "hide",
            "last4",
            "show"
          ],
          "title": "Redaction",
          "type": "string"
        },
        "verify_as": {
          "default": "auto",
          "description": "How local post-action checks may recognize this value. Auto accepts an exact value or an observed masked representation.",
          "enum": [
            "auto",
            "exact",
            "normalized",
            "masked"
          ],
          "title": "Verify As",
          "type": "string"
        },
        "normalizers": {
          "description": "Transformations permitted before local value comparison.",
          "items": {
            "enum": [
              "whitespace",
              "hyphens",
              "case",
              "currency",
              "grouping"
            ],
            "type": "string"
          },
          "title": "Normalizers",
          "type": "array"
        },
        "visible_suffix": {
          "default": 0,
          "description": "Characters that may remain visible at the end of a masked value.",
          "minimum": 0,
          "title": "Visible Suffix",
          "type": "integer"
        },
        "masked_length": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required displayed length for a masked value. Defaults to input length.",
          "title": "Masked Length"
        },
        "refused": {
          "default": false,
          "description": "True where this app refuses the value, which is a fact about the app that no reading of the value could find. A scenario about a refusal names one of these, and the declaration answers for it.",
          "title": "Refused",
          "type": "boolean"
        }
      },
      "required": [
        "value"
      ],
      "title": "DeclaredValue",
      "type": "object"
    },
    "DeeplinkCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "deeplink",
          "default": "deeplink",
          "title": "Kind",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "DeeplinkCapability",
      "type": "object"
    },
    "DeviceLockCapability": {
      "additionalProperties": false,
      "description": "Lock and unlock as one bounded interruption.\n\nKeeping this atomic prevents the planner from trying to interact with the\noperating-system lock screen, which is outside the app under test.",
      "properties": {
        "kind": {
          "const": "device_lock",
          "default": "device_lock",
          "title": "Kind",
          "type": "string"
        },
        "duration_seconds": {
          "default": 1.0,
          "maximum": 60,
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        }
      },
      "title": "DeviceLockCapability",
      "type": "object"
    },
    "DeviceSpec": {
      "additionalProperties": false,
      "description": "The target a run drives.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Emulator, simulator or device name.",
          "title": "Name"
        },
        "platform": {
          "anyOf": [
            {
              "enum": [
                "android",
                "ios"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which platform to run against.",
          "title": "Platform"
        },
        "headless": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Run the emulator without a window.",
          "title": "Headless"
        }
      },
      "title": "DeviceSpec",
      "type": "object"
    },
    "InterruptCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "interrupt",
          "default": "interrupt",
          "title": "Kind",
          "type": "string"
        },
        "type": {
          "enum": [
            "low_memory",
            "incoming_call"
          ],
          "title": "Type",
          "type": "string"
        },
        "phone": {
          "default": "555-5555",
          "description": "Used by 'incoming_call' only.",
          "title": "Phone",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "InterruptCapability",
      "type": "object"
    },
    "JourneySpec": {
      "additionalProperties": false,
      "description": "One test: what a user does, and what must be true afterwards.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "journey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The journey, in prose.",
          "title": "Journey"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Another spelling of 'journey'.",
          "title": "Description"
        },
        "security_rules": {
          "description": "Rules every scenario must respect.",
          "items": {
            "type": "string"
          },
          "title": "Security Rules",
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/DeclaredValue"
              },
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "description": "Values for this test, over the workflow's.",
          "title": "Env",
          "type": "object"
        },
        "preconditions": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScenarioPreconditions"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional app and device state applied before visible UI execution."
        }
      },
      "title": "JourneySpec",
      "type": "object"
    },
    "LocaleCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "locale",
          "default": "locale",
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "description": "An ISO code, e.g. 'fr'.",
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "country": {
          "default": "",
          "description": "An ISO code, e.g. 'FR'. May be empty.",
          "title": "Country",
          "type": "string"
        }
      },
      "required": [
        "language"
      ],
      "title": "LocaleCapability",
      "type": "object"
    },
    "LocationCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "location",
          "default": "location",
          "title": "Kind",
          "type": "string"
        },
        "latitude": {
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "LocationCapability",
      "type": "object"
    },
    "MediaInjectCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "media_inject",
          "default": "media_inject",
          "title": "Kind",
          "type": "string"
        },
        "local_path": {
          "minLength": 1,
          "title": "Local Path",
          "type": "string"
        }
      },
      "required": [
        "local_path"
      ],
      "title": "MediaInjectCapability",
      "type": "object"
    },
    "NetworkCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "network",
          "default": "network",
          "title": "Kind",
          "type": "string"
        },
        "mode": {
          "enum": [
            "offline",
            "online",
            "wifi_only",
            "data_only",
            "airplane",
            "slow_2g",
            "slow_3g",
            "high_latency"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "NetworkCapability",
      "type": "object"
    },
    "OrientationCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "orientation",
          "default": "orientation",
          "title": "Kind",
          "type": "string"
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ],
          "title": "Orientation",
          "type": "string"
        }
      },
      "required": [
        "orientation"
      ],
      "title": "OrientationCapability",
      "type": "object"
    },
    "PermissionCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "permission",
          "default": "permission",
          "title": "Kind",
          "type": "string"
        },
        "permission": {
          "enum": [
            "camera",
            "location",
            "microphone",
            "notifications",
            "photos",
            "contacts",
            "storage"
          ],
          "title": "Permission",
          "type": "string"
        },
        "grant": {
          "title": "Grant",
          "type": "boolean"
        }
      },
      "required": [
        "permission",
        "grant"
      ],
      "title": "PermissionCapability",
      "type": "object"
    },
    "PolicySpec": {
      "additionalProperties": false,
      "description": "Static package-policy exceptions, keyed by stable check ID.",
      "properties": {
        "waive": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Policy check IDs accepted for this workflow, with the reason each exception is necessary.",
          "title": "Waive",
          "type": "object"
        }
      },
      "title": "PolicySpec",
      "type": "object"
    },
    "Priority": {
      "description": "Which cells a run has to finish first.\n\nA run can die part way: a device drops, a provider refuses, a person\nstops it. The order decides what it got through, so a product says which\ncells matter rather than a table in Yewo.",
      "enum": [
        "P0",
        "P1",
        "P2"
      ],
      "title": "Priority",
      "type": "string"
    },
    "ScenarioPreconditions": {
      "description": "Optional state declared for every scenario in one journey.",
      "properties": {
        "app_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/SetupMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Initial app state. Independent scenarios default to clear_data."
        },
        "capabilities": {
          "description": "Device states to apply and confirm before visible UI execution.",
          "items": {
            "discriminator": {
              "mapping": {
                "accessibility": "#/$defs/AccessibilityCapability",
                "app_state": "#/$defs/AppStateCapability",
                "battery": "#/$defs/BatteryCapability",
                "biometric": "#/$defs/BiometricCapability",
                "clipboard": "#/$defs/ClipboardCapability",
                "deeplink": "#/$defs/DeeplinkCapability",
                "device_lock": "#/$defs/DeviceLockCapability",
                "interrupt": "#/$defs/InterruptCapability",
                "locale": "#/$defs/LocaleCapability",
                "location": "#/$defs/LocationCapability",
                "media_inject": "#/$defs/MediaInjectCapability",
                "network": "#/$defs/NetworkCapability",
                "orientation": "#/$defs/OrientationCapability",
                "permission": "#/$defs/PermissionCapability",
                "timezone": "#/$defs/TimezoneCapability"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LocationCapability"
              },
              {
                "$ref": "#/$defs/NetworkCapability"
              },
              {
                "$ref": "#/$defs/BatteryCapability"
              },
              {
                "$ref": "#/$defs/TimezoneCapability"
              },
              {
                "$ref": "#/$defs/LocaleCapability"
              },
              {
                "$ref": "#/$defs/PermissionCapability"
              },
              {
                "$ref": "#/$defs/InterruptCapability"
              },
              {
                "$ref": "#/$defs/BiometricCapability"
              },
              {
                "$ref": "#/$defs/ClipboardCapability"
              },
              {
                "$ref": "#/$defs/DeeplinkCapability"
              },
              {
                "$ref": "#/$defs/AppStateCapability"
              },
              {
                "$ref": "#/$defs/OrientationCapability"
              },
              {
                "$ref": "#/$defs/DeviceLockCapability"
              },
              {
                "$ref": "#/$defs/MediaInjectCapability"
              },
              {
                "$ref": "#/$defs/AccessibilityCapability"
              }
            ]
          },
          "title": "Capabilities",
          "type": "array"
        }
      },
      "title": "ScenarioPreconditions",
      "type": "object"
    },
    "ScenarioType": {
      "description": "What shape a scenario takes.",
      "enum": [
        "happy_path",
        "negative",
        "boundary",
        "empty",
        "concurrency",
        "interruption",
        "recovery",
        "role",
        "exploratory"
      ],
      "title": "ScenarioType",
      "type": "string"
    },
    "SetupMode": {
      "description": "The state a scenario needs before its first step.\n\nRequired state is part of what a test is. Stated in a prompt instead, it\nis an assumption, and a prompt enforces nothing.",
      "enum": [
        "clear_data",
        "relaunch",
        "preserve"
      ],
      "title": "SetupMode",
      "type": "string"
    },
    "TargetSpec": {
      "additionalProperties": false,
      "description": "One explicitly named member of a sequential target matrix.",
      "properties": {
        "id": {
          "description": "Stable target name used in reports and artifact paths.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "platform": {
          "enum": [
            "android",
            "ios"
          ],
          "title": "Platform",
          "type": "string"
        },
        "device": {
          "description": "Emulator, simulator, or device name.",
          "minLength": 1,
          "title": "Device",
          "type": "string"
        },
        "app": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target-specific app binary. Falls back to the workflow app.",
          "title": "App"
        },
        "app_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Another spelling of the target-specific app.",
          "title": "App Path"
        },
        "headless": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Run this target's emulator without a window.",
          "title": "Headless"
        }
      },
      "required": [
        "id",
        "platform",
        "device"
      ],
      "title": "TargetSpec",
      "type": "object"
    },
    "TimezoneCapability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "timezone",
          "default": "timezone",
          "title": "Kind",
          "type": "string"
        },
        "timezone": {
          "description": "An IANA name, e.g. 'America/New_York'.",
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "timezone"
      ],
      "title": "TimezoneCapability",
      "type": "object"
    },
    "WorkflowSpec": {
      "additionalProperties": false,
      "description": "One environment, its target or targets, and the tests to run there.",
      "properties": {
        "device": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceSpec"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The target, as a name or a block.",
          "title": "Device"
        },
        "emulator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Another spelling of 'device'.",
          "title": "Emulator"
        },
        "platform": {
          "anyOf": [
            {
              "enum": [
                "android",
                "ios"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "headless": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headless"
        },
        "app": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "App binary, relative to this file.",
          "title": "App"
        },
        "app_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Another spelling of 'app'.",
          "title": "App Path"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "perception_model": {
          "anyOf": [
            {
              "pattern": "^hf://[^/@\\s]+/[^@\\s]+@[0-9a-f]{40}$",
              "type": "string"
