{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/yewohq/yewo/master/yewo-schema.json",
  "$defs": {
    "AccessibilityCapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "accessibility",
          "default": "accessibility",
          "title": "Kind",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "AccessibilityCapabilitySpec",
      "type": "object"
    },
    "AppStateCapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "app_state",
          "default": "app_state",
          "title": "Kind",
          "type": "string"
        },
        "action": {
          "enum": [
            "force_stop",
            "clear_data",
            "relaunch",
            "background_resume"
          ],
          "title": "Action",
          "type": "string"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "maximum": 60,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        }
      },
      "required": [
        "action"
      ],
      "title": "AppStateCapabilitySpec",
      "type": "object"
    },
    "BatteryCapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "battery",
          "default": "battery",
          "title": "Kind",
          "type": "string"
        },
        "level": {
          "maximum": 100,
          "minimum": 0,
          "title": "Level",
          "type": "integer"
        },
        "charging": {
          "default": true,
          "title": "Charging",
          "type": "boolean"
        }
      },
      "required": [
        "level"
      ],
      "title": "BatteryCapabilitySpec",
      "type": "object"
    },
    "BiometricCapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "biometric",
          "default": "biometric",
          "title": "Kind",
          "type": "string"
        },
        "action": {
          "enum": [
            "match",
            "unmatch",
            "enroll"
          ],
          "title": "Action",
          "type": "string"
        },
        "type": {
          "default": "faceId",
          "enum": [
            "faceId",
            "touchId"
          ],
          "title": "Type",
          "type": "string"
        },
        "finger_id": {
          "default": 1,
          "minimum": 1,
          "title": "Finger Id",
          "type": "integer"
        }
      },
      "required": [
        "action"
      ],
      "title": "BiometricCapabilitySpec",
      "type": "object"
    },
    "ClipboardCapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "clipboard",
          "default": "clipboard",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ClipboardCapabilitySpec",
      "type": "object"
    },
    "CoverageCategory": {
      "description": "A general QA lens applied to a discovered application surface.",
      "enum": [
        "functional",
        "data_consistency",
        "state",
        "input",
        "navigation",
        "error_handling",
        "ui_visual",
        "security",
        "accessibility",
        "performance",
        "network",
        "lifecycle",
        "permission",
        "compatibility",
        "installation",
        "localization",
        "regression"
      ],
      "title": "CoverageCategory",
      "type": "string"
    },
    "CoveragePriority": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ],
      "title": "CoveragePriority",
      "type": "string"
    },
    "CoverageSpec": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/CoverageCategory"
        },
        "types": {
          "items": {
            "$ref": "#/$defs/ScenarioType"
          },
          "minItems": 1,
          "title": "Types",
          "type": "array"
        },
        "priority": {
          "$ref": "#/$defs/CoveragePriority",
          "default": "P1"
        }
      },
      "required": [
        "category",
        "types"
      ],
      "title": "CoverageSpec",
      "type": "object"
    },
    "DeclaredValueSpec": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        },
        "secret": {
          "default": false,
          "title": "Secret",
          "type": "boolean"
        },
        "refused": {
          "default": false,
          "title": "Refused",
          "type": "boolean"
        }
      },
      "required": [
        "value"
      ],
      "title": "DeclaredValueSpec",
      "type": "object"
    },
    "DeepLinkCapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "deeplink",
          "default": "deeplink",
          "title": "Kind",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "DeepLinkCapabilitySpec",
      "type": "object"
    },
    "DeviceLockCapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "device_lock",
          "default": "device_lock",
          "title": "Kind",
          "type": "string"
        },
        "duration_seconds": {
          "default": 1.0,
          "maximum": 60,
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        }
      },
      "title": "DeviceLockCapabilitySpec",
      "type": "object"
    },
    "DeviceSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "platform": {
          "anyOf": [
            {
              "enum": [
                "android",
                "ios"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "headless": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headless"
        }
      },
      "title": "DeviceSpec",
      "type": "object"
    },
    "GrounderSelectionSpec": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/GroundingProtocol"
        },
        "reasoning": {
          "$ref": "#/$defs/ReasoningSetting",
          "default": "provider_default"
        }
      },
      "required": [
        "model",
        "protocol"
      ],
      "title": "GrounderSelectionSpec",
      "type": "object"
    },
    "GroundingProtocol": {
      "enum": [
        "source_pixels",
        "normalized",
        "normalized_1000"
      ],
      "title": "GroundingProtocol",
      "type": "string"
    },
    "InterruptCapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "interrupt",
          "default": "interrupt",
          "title": "Kind",
          "type": "string"
        },
        "type": {
          "enum": [
            "low_memory",
            "incoming_call"
          ],
          "title": "Type",
          "type": "string"
        },
        "phone": {
          "default": "555-5555",
          "title": "Phone",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "InterruptCapabilitySpec",
      "type": "object"
    },
    "JourneySpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "journey": {
          "minLength": 1,
          "title": "Journey",
          "type": "string"
        },
        "security_rules": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Security Rules",
          "type": "array"
        },
        "checks": {
          "default": [],
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Checks",
          "type": "array"
        },
        "env": {
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DeclaredValueSpec"
                },
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "propertyNames": {
            "maxLength": 100,
            "minLength": 1
          },
          "title": "Env",
          "type": "object"
        },
        "preconditions": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScenarioPreconditionsSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "journey"
      ],
      "title": "JourneySpec",
      "type": "object"
    },
    "LocaleCapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "locale",
          "default": "locale",
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "country": {
          "default": "",
          "title": "Country",
          "type": "string"
        }
      },
      "required": [
        "language"
      ],
      "title": "LocaleCapabilitySpec",
      "type": "object"
    },
    "LocationCapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "location",
          "default": "location",
          "title": "Kind",
          "type": "string"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "LocationCapabilitySpec",
      "type": "object"
    },
    "MediaInjectCapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "media_inject",
          "default": "media_inject",
          "title": "Kind",
          "type": "string"
        },
        "local_path": {
          "minLength": 1,
          "title": "Local Path",
          "type": "string"
        }
      },
      "required": [
        "local_path"
      ],
      "title": "MediaInjectCapabilitySpec",
      "type": "object"
    },
    "ModelOverridesSpec": {
      "additionalProperties": false,
      "properties": {
        "planner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ModelSelectionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planner"
        },
        "auditor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ModelSelectionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auditor"
        },
        "recovery": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ModelSelectionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recovery"
        },
        "proposal_verifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ModelSelectionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Verifier"
        },
        "outcome_verifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ModelSelectionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome Verifier"
        },
        "screen_analyzer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ModelSelectionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screen Analyzer"
        },
        "replay_preparer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ModelSelectionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replay Preparer"
        },
        "test_designer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ModelSelectionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Designer"
        }
      },
      "title": "ModelOverridesSpec",
      "type": "object"
    },
    "ModelSelectionSpec": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "reasoning": {
          "$ref": "#/$defs/ReasoningSetting",
          "default": "provider_default"
        }
      },
      "required": [
        "model"
      ],
      "title": "ModelSelectionSpec",
      "type": "object"
    },
    "NetworkCapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "network",
          "default": "network",
          "title": "Kind",
          "type": "string"
        },
        "mode": {
          "enum": [
            "offline",
            "online",
            "wifi_only",
            "data_only",
            "airplane",
            "slow_2g",
            "slow_3g",
            "high_latency"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "NetworkCapabilitySpec",
      "type": "object"
    },
    "OrientationCapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "orientation",
          "default": "orientation",
          "title": "Kind",
          "type": "string"
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ],
          "title": "Orientation",
          "type": "string"
        }
      },
      "required": [
        "orientation"
      ],
      "title": "OrientationCapabilitySpec",
      "type": "object"
    },
    "PermissionCapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "permission",
          "default": "permission",
          "title": "Kind",
          "type": "string"
        },
        "permission": {
          "enum": [
            "camera",
            "location",
            "microphone",
            "notifications",
            "photos",
            "contacts",
            "storage"
          ],
          "title": "Permission",
          "type": "string"
        },
        "grant": {
          "title": "Grant",
          "type": "boolean"
        }
      },
      "required": [
        "permission",
        "grant"
      ],
      "title": "PermissionCapabilitySpec",
      "type": "object"
    },
    "PolicySpec": {
      "additionalProperties": false,
      "properties": {
        "waive": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Waive",
          "type": "object"
        }
      },
      "title": "PolicySpec",
      "type": "object"
    },
    "ReasoningSetting": {
      "description": "How much private reasoning one role may spend before it answers.\n\nAn effort keeps reasoning and bounds it. Reasoning and the answer share one completion\nbudget, so a role left to the provider can spend the whole budget thinking and return\nnothing.",
      "enum": [
        "disabled",
        "provider_default",
        "minimal",
        "low",
        "medium",
        "high"
      ],
      "title": "ReasoningSetting",
      "type": "string"
    },
    "ScenarioPreconditionsSpec": {
      "additionalProperties": false,
      "description": "Application and device state requested before visible execution.",
      "properties": {
        "app_state": {
          "default": "clear_data",
          "enum": [
            "clear_data",
            "restart",
            "preserve"
          ],
          "title": "App State",
          "type": "string"
        },
        "capabilities": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "accessibility": "#/$defs/AccessibilityCapabilitySpec",
                "app_state": "#/$defs/AppStateCapabilitySpec",
                "battery": "#/$defs/BatteryCapabilitySpec",
                "biometric": "#/$defs/BiometricCapabilitySpec",
                "clipboard": "#/$defs/ClipboardCapabilitySpec",
                "deeplink": "#/$defs/DeepLinkCapabilitySpec",
                "device_lock": "#/$defs/DeviceLockCapabilitySpec",
                "interrupt": "#/$defs/InterruptCapabilitySpec",
                "locale": "#/$defs/LocaleCapabilitySpec",
                "location": "#/$defs/LocationCapabilitySpec",
                "media_inject": "#/$defs/MediaInjectCapabilitySpec",
                "network": "#/$defs/NetworkCapabilitySpec",
                "orientation": "#/$defs/OrientationCapabilitySpec",
                "permission": "#/$defs/PermissionCapabilitySpec",
                "timezone": "#/$defs/TimezoneCapabilitySpec"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LocationCapabilitySpec"
              },
              {
                "$ref": "#/$defs/NetworkCapabilitySpec"
              },
              {
                "$ref": "#/$defs/BatteryCapabilitySpec"
              },
              {
                "$ref": "#/$defs/TimezoneCapabilitySpec"
              },
              {
                "$ref": "#/$defs/LocaleCapabilitySpec"
              },
              {
                "$ref": "#/$defs/PermissionCapabilitySpec"
              },
              {
                "$ref": "#/$defs/InterruptCapabilitySpec"
              },
              {
                "$ref": "#/$defs/BiometricCapabilitySpec"
              },
              {
                "$ref": "#/$defs/ClipboardCapabilitySpec"
              },
              {
                "$ref": "#/$defs/DeepLinkCapabilitySpec"
              },
              {
                "$ref": "#/$defs/AppStateCapabilitySpec"
              },
              {
                "$ref": "#/$defs/OrientationCapabilitySpec"
              },
              {
                "$ref": "#/$defs/DeviceLockCapabilitySpec"
              },
              {
                "$ref": "#/$defs/MediaInjectCapabilitySpec"
              },
              {
                "$ref": "#/$defs/AccessibilityCapabilitySpec"
              }
            ]
          },
          "title": "Capabilities",
          "type": "array"
        }
      },
      "title": "ScenarioPreconditionsSpec",
      "type": "object"
    },
    "ScenarioType": {
      "description": "The variation strategy used within one testing category.",
      "enum": [
        "happy_path",
        "negative",
        "boundary",
        "empty",
        "concurrency",
        "interruption",
        "recovery",
        "role",
        "exploratory"
      ],
      "title": "ScenarioType",
      "type": "string"
    },
    "TargetSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "platform": {
          "enum": [
            "android",
            "ios"
          ],
          "title": "Platform",
          "type": "string"
        },
        "device": {
          "minLength": 1,
          "title": "Device",
          "type": "string"
        },
        "app": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "App"
        },
        "headless": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headless"
        }
      },
      "required": [
        "id",
        "platform",
        "device"
      ],
      "title": "TargetSpec",
      "type": "object"
    },
    "TimezoneCapabilitySpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "timezone",
          "default": "timezone",
          "title": "Kind",
          "type": "string"
        },
        "timezone": {
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "timezone"
      ],
      "title": "TimezoneCapabilitySpec",
      "type": "object"
    },
    "WorkflowSpec": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceSpec"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        },
        "platform": {
          "anyOf": [
            {
              "enum": [
                "android",
                "ios"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "headless": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headless"
        },
        "app": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "App"
        },
        "model": {
          "anyOf": [
